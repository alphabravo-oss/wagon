# Wagon Environment Configuration
# Copy to .env and adjust. This lists every environment variable Wagon reads.
# deploy/docker-compose.yml passes every value here to the container (env_file),
# so keep only Wagon settings in this file.
# The HAULER_UI_* prefix is retained for compatibility with existing deployments.
#
# Keep comments on their own line. Docker Compose reads `KEY=   # text` as the
# value "# text", not as an empty value.

# ---------------------------------------------------------------------------
# Server & auth
# ---------------------------------------------------------------------------
# HTTP UI/API server port
PORT=8080
# REQUIRED shared password for UI/API login; Wagon refuses to start if empty
HAULER_UI_PASSWORD=
# Compose only: host address the ports are published on. 127.0.0.1 = this host only.
# To expose Wagon deliberately, set a LAN interface IP (or 0.0.0.0 for all interfaces).
HAULER_UI_BIND_ADDR=127.0.0.1
# Extra browser origins (comma-separated, e.g. https://wagon.example.com) allowed to make
# changes. Only needed behind a reverse proxy that rewrites the Host header.
HAULER_UI_TRUSTED_ORIGINS=
# DANGER: true starts Wagon with NO authentication; anyone who can reach the port has full
# control. Only for throwaway local testing. Never expose such an instance.
HAULER_UI_INSECURE_NO_AUTH=false
# Max login attempts per minute per client IP (429 beyond)
HAULER_UI_LOGIN_RATE=5
# Trust the rightmost X-Forwarded-For hop for rate-limit IP keying; only enable behind a trusted reverse proxy
HAULER_UI_TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Add File url downloads
# ---------------------------------------------------------------------------
# Wagon downloads an Add File url itself, directly (no HTTP proxy), and refuses loopback,
# link-local (including cloud metadata 169.254.169.254), multicast and reserved addresses
# on every connection and redirect. Private ranges (10/8, 172.16/12, 192.168/16, CGNAT
# 100.64/10, IPv6 fc00::/7) are refused too unless listed here, comma-separated,
# e.g. 10.20.0.0/16,192.168.5.0/24. Loopback and link-local cannot be allowed.
HAULER_UI_FETCH_ALLOW_CIDRS=
# Max size of one download in bytes (default 2147483648 = 2 GiB)
HAULER_UI_FETCH_MAX_BYTES=2147483648
# Max time for one download, redirects included (Go duration)
HAULER_UI_FETCH_TIMEOUT=30m

# ---------------------------------------------------------------------------
# Published registry / files  (the multi-haul front door)
# ---------------------------------------------------------------------------
# Single host-routed port serving all published haul registries
HAULER_UI_REGISTRY_PORT=5000
# Base domain for <slug>.<domain> registry routing
HAULER_UI_REGISTRY_DOMAIN=
# Idle timeout before a published registry subprocess is reaped (Go duration)
HAULER_UI_REGISTRY_IDLE=5m
# Path to a TLS cert for the registry port (self-signed if unset)
HAULER_UI_REGISTRY_TLS_CERT=
# Path to the TLS key (self-signed if unset)
HAULER_UI_REGISTRY_TLS_KEY=

# Basic auth guarding the published registry AND the /h/ file endpoints.
# If BOTH user and password are left empty the endpoints are OPEN and a startup WARNING is logged.
# HTTP Basic auth username
HAULER_UI_PUBLISH_USER=
# HTTP Basic auth password
HAULER_UI_PUBLISH_PASSWORD=

# ---------------------------------------------------------------------------
# Jobs & logging  (observability)
# ---------------------------------------------------------------------------
# Max background jobs run at once
HAULER_UI_MAX_CONCURRENT_JOBS=2
# UI server log format: json or text
HAULER_UI_LOG_FORMAT=json
# UI server log level: debug | info | warn | error
HAULER_UI_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Hauler CLI & paths
# ---------------------------------------------------------------------------
# Hauler binary name/path
HAULER_BINARY=hauler
# Hauler CLI log level
HAULER_LOG_LEVEL=info
# Continue past non-fatal hauler errors
HAULER_IGNORE_ERRORS=false
# Retries for hauler ops (also settable in the Settings UI)
HAULER_RETRIES=0

# Data directories (usually left at defaults for containerized deployment)
# Base hauler working directory
HAULER_DIR=/data
# Hauler content store directory
HAULER_STORE_DIR=/data/store
# Hauler temp/scratch directory
HAULER_TEMP_DIR=/data/tmp

# Docker config dir for registry credentials
DOCKER_CONFIG=/data/.docker
# SQLite database file path
DATABASE_PATH=/data/app.db
